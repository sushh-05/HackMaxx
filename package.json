{
  "name": "hackmaxx",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["web", "backend", "shared"],
  "scripts": {
    "dev": "bun --cwd web run dev",
    "dev:backend": "bun --cwd backend run dev",
    "build": "bun --cwd web run build",
    "typecheck": "tsc -p shared/tsconfig.json --noEmit && tsc -p backend/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "seed": "bun scripts/seed.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "packageManager": "bun@1.4.2"
}
