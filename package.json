{
  "name": "hackmaxx",
  "version": "0.1.0",
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^5.6.0"
  },
  "packageManager": "bun@1.4.2",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n \"backend,web\" -c \"cyan.bold,magenta.bold\" \"bun run dev:backend\" \"bun run dev:web\"",
    "dev:all": "bun run dev",
    "dev:web": "bun run --cwd web dev",
    "dev:backend": "bun run --cwd backend dev",
    "build": "bun run --cwd web build",
    "typecheck": "tsc -p shared/tsconfig.json --noEmit && tsc -p backend/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "seed": "bun scripts/seed.ts"
  },
  "workspaces": ["web", "backend", "shared"],
  "dependencies": {
    "next": "^16.3.5"
  }
}
