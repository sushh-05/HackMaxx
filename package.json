{
  "name": "hackmaxx",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "bun run --cwd web dev",
    "dev:backend": "bun run --cwd backend dev",
    "dev:python": "uvicorn app.main:app --reload --port 8000",
    "build": "bun run --cwd web build",
    "typecheck": "tsc -p shared/tsconfig.json --noEmit && tsc -p backend/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "seed": "bun scripts/seed.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "packageManager": "bun@1.4.2"
}