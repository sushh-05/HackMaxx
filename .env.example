# Copy to .env (root) and web/.env.local as needed. Never commit real keys.
# --- AWS ---
AWS_REGION=ap-south-1
HACKATHONS_TABLE=Hackathons-dev
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_LLM_MODEL=anthropic.claude-3-haiku-20240307-v1:0

# --- TinyFish (live hackathon discovery) ---
TINYFISH_API_KEY=
TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai
TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai

# --- API ---
API_BASE_URL=http://localhost:3001

# --- Clerk (auth, GATED — OFF for MVP judging flow) ---
CLERK_ENABLED=false
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- OpenUI ---
OPENUI_ENABLED=false
